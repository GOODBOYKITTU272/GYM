# NowWise — environment variable template
# Copy to .env.local (web) / .env (services) and fill in real values.
# PLACEHOLDERS ONLY — never commit real secrets to this file.
# Variable list mirrors docs/02-TRD.md §12.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_ENV=local

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_WEBHOOK_URL=https://your-domain/api/telegram/webhook

# --- AI Providers ---
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_GENERATIVE_AI_API_KEY=replace-me
GROQ_API_KEY=replace-me

# --- Voice / ASR ---
# OpenWhispr is an architecture reference and ASR service pattern (the FastAPI
# wrapper in services/voice-service), not a separate transcription engine.
VOICE_PROVIDER_DEFAULT=local
LOCAL_ASR_BASE_URL=http://localhost:8000
LOCAL_ASR_API_KEY=replace-me
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
DEEPGRAM_API_KEY=replace-me
WISPR_FLOW_API_KEY=replace-me

# --- Storage ---
SUPABASE_AUDIO_BUCKET=audio
SUPABASE_PHOTO_BUCKET=photos
SUPABASE_RECEIPT_BUCKET=receipts

# --- Queue (Redis + BullMQ — target architecture, not used in Phase 1) ---
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=nowwise

# --- Monitoring ---
SENTRY_DSN=replace-me
LOG_LEVEL=info

# --- Admin ---
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_INVITE_SECRET=replace-me

# --- AI review threshold (configurable; default 0.70) ---
AI_CONFIDENCE_THRESHOLD=0.70
