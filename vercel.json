{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "voice-service": {
      "root": "services/voice-service",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/voice-service(/.*)?",
      "destination": {
        "service": "voice-service"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
